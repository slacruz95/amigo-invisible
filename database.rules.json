{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('owner').val() == auth.uid",
        ".write": "auth != null && (($room.matches(/^[a-f0-9]{32}$/) && !data.exists() && newData.child('owner').val() == auth.uid && newData.child('phase').val() == 'open' && !newData.child('tickets').exists() && !newData.child('names').exists()) || (data.child('owner').val() == auth.uid && newData.child('owner').val() == auth.uid))",
        ".validate": "newData.hasChildren(['owner','phase'])",
        "owner": {
          ".validate": "newData.isString()"
        },
        "phase": {
          ".read": true,
          ".validate": "newData.val() == 'open' || newData.val() == 'drawn'"
        },
        "tickets": {
          "$token": {
            ".read": "$token.matches(/^[a-f0-9]{64}$/)",
            ".write": "!data.exists() && newData.exists() && root.child('rooms').child($room).child('phase').val() == 'open' && !newData.child('recipient').exists()",
            ".validate": "$token.matches(/^[a-f0-9]{64}$/) && newData.hasChildren(['name','key']) && newData.parent().parent().child('names').child(newData.child('key').val()).val() == $token",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "key": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
            },
            "recipient": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "names": {
          "$key": {
            ".write": "!data.exists() && newData.exists() && root.child('rooms').child($room).child('phase').val() == 'open'",
            ".validate": "$key.matches(/^[a-f0-9]{64}$/) && newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/) && newData.parent().parent().child('tickets').child(newData.val()).child('key').val() == $key"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
