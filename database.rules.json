{
  "rules": {
    "rooms": {
      "$room": {
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() == true) && (($room.matches(/^[a-f0-9]{32}$/) && !data.exists() && newData.child('owner').val() == auth.uid && newData.child('phase').val() == 'open' && !newData.child('tickets').exists() && !newData.child('names').exists()) || (data.exists() && newData.child('owner').val() == data.child('owner').val()))",
        ".validate": "newData.hasChildren(['owner','phase'])",
        "owner": {
          ".validate": "newData.isString()"
        },
        "phase": {
          ".read": true,
          ".validate": "newData.val() == 'open' || newData.val() == 'drawn'"
        },
        "tickets": {
          "$token": {
            ".read": "$token.matches(/^[a-f0-9]{64}$/)",
            ".write": "!data.exists() && newData.exists() && root.child('rooms').child($room).child('phase').val() == 'open' && !newData.child('recipient').exists()",
            ".validate": "$token.matches(/^[a-f0-9]{64}$/) && newData.hasChildren(['name','key']) && newData.parent().parent().child('names').child(newData.child('key').val()).val() == $token",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "key": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
            },
            "recipient": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "names": {
          "$key": {
            ".write": "!data.exists() && newData.exists() && root.child('rooms').child($room).child('phase').val() == 'open'",
            ".validate": "$key.matches(/^[a-f0-9]{64}$/) && newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/) && newData.parent().parent().child('tickets').child(newData.val()).child('key').val() == $key"
          }
        },
        "$other": {
          ".validate": false
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    },
    "live": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "round": {
        ".read": true,
        ".validate": "newData.isNumber() && newData.val() >= 1"
      },
      "audit": {
        ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
      },
      "tickets": {
        "$token": {
          ".read": "$token.matches(/^[a-f0-9]{64}$/)",
          ".write": "!data.exists() && newData.exists() && !root.child('live').child('round').exists() && !newData.child('recipient').exists() && !newData.child('round').exists()",
          ".validate": "$token.matches(/^[a-f0-9]{64}$/) && newData.hasChildren(['name','key']) && newData.parent().parent().child('names').child(newData.child('key').val()).val() == $token",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "key": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
          },
          "recipient": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          }
        }
      },
      "names": {
        "$key": {
          ".write": "!data.exists() && newData.exists() && !root.child('live').child('round').exists()",
          ".validate": "$key.matches(/^[a-f0-9]{64}$/) && newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/) && newData.parent().parent().child('tickets').child(newData.val()).child('key').val() == $key"
        }
      },
      "verification": {
        "$token": {
          ".read": "$token.matches(/^[a-f0-9]{64}$/)"
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
